{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/serve.mjs",
      "startServerReadyPattern": "Serving dist",
      "url": [
        "http://localhost:4173/",
        "http://localhost:4173/blackjack/",
        "http://localhost:4173/mines/",
        "http://localhost:4173/higher-or-lower/",
        "http://localhost:4173/sudoku/",
        "http://localhost:4173/2048/",
        "http://localhost:4173/tic-tac-toe/",
        "http://localhost:4173/rock-paper-scissors/",
        "http://localhost:4173/number-guess/"
      ],
      "numberOfRuns": 3,
      "settings": { "chromeFlags": "--no-sandbox --headless=new" }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 1 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": "lighthouse-report" }
  }
}
